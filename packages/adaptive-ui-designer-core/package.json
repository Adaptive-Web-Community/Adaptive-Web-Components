{
  "name": "@adaptive-web/adaptive-ui-designer-core",
  "version": "0.6.2",
  "description": "Core infrastructure for the Adaptive UI Designer",
  "main": "dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/dts/index.d.ts",
      "default": "./dist/esm/index.js"
    }
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist",
    "build": "rimraf dist && tsc",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "npm run lint && npm run build && npm run unit-tests",
    "unit-tests": "mocha",
    "watch": "tsc --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adaptive-Web-Community/Adaptive-Web-Components",
    "directory": "packages/adaptive-ui-designer-core"
  },
  "author": {
    "name": "Adaptive Web Community",
