  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/adaptive-web-community/adaptive-web-components/issues"
  },
  "homepage": "https://github.com/adaptive-web-community/adaptive-web-components#readme",
  "dependencies": {
    "@adaptive-web/adaptive-ui": "1.0.0-beta.1",
    "culori": "^4.0.2",
    "tslog": "^4.10.2"
  },
  "devDependencies": {
    "@types/chai": "^4.3.4",
    "@types/culori": "^4.0.1",
    "@types/mocha": "^10.0.1",
    "chai": "^4.3.7",
    "mocha": "^10.2.0",
    "rimraf": "^3.0.2"
  }
}
