{
  "name": "Button",
  "context": ".button",
  "conditions": {
    "Purpose": {
      "Normal": ".purpose-normal",
      "Primary": ".purpose-primary",
      "Critical": ".purpose-critical",
      "Generative AI": ".purpose-generative-ai",
      "Anchor - Standalone": ".purpose-anchor-standalone"
    },
    "Icon-only": ".icon-only"
  },
  "parts": {
    "Content": ".content"
  },
  "interactivity": {
    "interactive": ":not(:disabled)",
    "disabled": ":disabled"
  },
  "focus": {
    "focusTarget": {
      "ignoreInteractivity": true
    }
  },
  "styleRules": [
    {
      "contextCondition": {
        "Purpose": "Normal"
      },
      "styles": ["styles.action-control", "styles.text-label", "color.neutral-fill-subtle-control"]
    },
    {
      "contextCondition": {
        "Purpose": "Normal",
        "Icon-only": true
      },
      "styles": ["density.control-square"]
    },
    {
      "contextCondition": {
        "Purpose": "Primary"
      },
      "styles": ["styles.action-control", "styles.text-label", "color.accent-fill-ideal-control"]
    },
    {
      "contextCondition": {
        "Purpose": "Primary",
        "Icon-only": true
      },
      "styles": ["density.control-square"]
    },
    {
      "contextCondition": {
        "Purpose": "Critical"
      },
      "styles": ["styles.action-control", "styles.text-label", "color.critical-fill-readable-control"]
    },
    {
      "contextCondition": {
        "Purpose": "Critical",
        "Icon-only": true
      },
      "styles": ["density.control-square"]
    },
    {
      "contextCondition": {
        "Purpose": "Generative AI"
      },
      "styles": [
        "styles.action-control",
        "text.type-ramp-base",
        "color.accent-fill-stealth-control",
        "styles.text-label"
      ],
      "properties": {
        "borderThicknessTop": "shape.strokeThickness.default",
        "borderThicknessRight": "shape.strokeThickness.default",
        "borderThicknessBottom": "shape.strokeThickness.default",
        "borderThicknessLeft": "shape.strokeThickness.default"
      }
    },
    {
      "contextCondition": {
        "Purpose": "Generative AI",
        "Icon-only": true
      },
      "styles": ["density.control-square"]
    },
    {
      "contextCondition": {
        "Purpose": "Anchor - Standalone"
      },
      "styles": ["shape.control", "styles.text-label", "color.accent-foreground-readable-control"],
      "properties": {
        "gap": "density.control.horizontal.gap"
      }
    }
  ]
}
