{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "importHelpers": true,
        "types": ["mocha", "node"],
        "lib": ["DOM", "ES2020"],
        "skipLibCheck": true,
        "declarationDir": "dist/dts",
        "outDir": "dist/esm",
        "rootDir": "src"
    },
    "include": ["src"],
    // Not yet migrated to the new token library. Remove from here as each is migrated.
    // Why: docs/decisions/0003-migrate-behind-an-exclusion-frontier.md
    "exclude": [
        "src/bin",
        "src/reference/appearance.ts",
        "src/reference/color.ts",
        "src/reference/density.ts",
        "src/reference/elevation.ts",
        "src/reference/experimental.ts",
        "src/reference/index.ts",
        "src/reference/modules.ts",
        "src/reference/parity.spec.ts",
        "src/reference/token-naming.ts",
        "src/reference/util.ts",
        "src/__test__",
        "src/core/elevation",
        "src/core/shadow",
        "src/core/token-helpers-color.ts",
        "src/core/token-helpers-color.spec.ts",
        "src/core/modules/element-styles-renderer.ts",
        "src/core/modules/element-styles-renderer.spec.ts",
        "src/core/modules/styles.ts",
        "src/core/modules/styles.spec.ts"
    ]
}
