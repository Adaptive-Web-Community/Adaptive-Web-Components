{
  "name": "@adaptive-web/adaptive-web-components",
  "version": "0.10.0",
  "description": "Standards based, framework agnostic web components built using FAST.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": {
    "name": "Adaptive Web Community",
    "url": "https://github.com/adaptive-web-community"
  },
  "bugs": {
    "url": "https://github.com/adaptive-web-community/adaptive-web-components/issues"
  },
  "homepage": "https://github.com/adaptive-web-community/adaptive-web-components#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adaptive-Web-Community/Adaptive-Web-Components",
    "directory": "packages/adaptive-web-components"
  },
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/dts/index.d.ts",
  "unpkg": "dist/adaptive-web-components.min.js",
  "scripts": {
    "build:styles": "aui compile-styles ./dist/esm/components/**/*/index.js -a '*Anatomy' -s '*StyleRules'",
    "build:tsc": "tsc -p ./tsconfig.build.json",
    "build:bundle": "rollup -c",
    "build": "rimraf dist && npm run build:tsc && npm run build:bundle && npm run cem:analyze",
    "build:storybook": "storybook build",
    "clean": "rimraf dist storybook-static",
    "cem:analyze": "cem analyze --config ./cem.config.mjs",
    "doc": "api-extractor run --local",
    "postbuild": "npm run doc",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "start": "storybook dev -p 6006",
    "test": "npm run lint && npm run build:tsc && tsc -p ./tsconfig.json --noEmit"
  },
  "dependencies": {
    "@adaptive-web/adaptive-ui": "1.0.0-beta.1",
    "@adaptive-web/components-foundation": "^0.1.0",
    "design-token-library": "^0.2.0",
    "tslib": "^2.5.0"
  },
  "peerDependencies": {
    "@microsoft/fast-element": "^3.1.2"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@microsoft/api-extractor": "^7.59.4",
    "@microsoft/fast-element": "^3.1.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/html-vite": "^10.6.5",
    "rimraf": "^3.0.2",
    "rollup": "^4.66.0",
    "rollup-plugin-fast-tagged-templates": "^1.0.3",
    "storybook": "^10.6.5",
    "vite": "^8.3.5"
  },
  "customElements": "dist/custom-elements.json",
  "exports": {
    "./custom-elements.json": "./dist/custom-elements.json",
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/dts/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./all-components": {
      "types": "./dist/dts/custom-elements.d.ts",
      "default": "./dist/esm/custom-elements.js"
    },
    "./*": {
      "types": "./dist/dts/components/*/*.definition.d.ts",
      "default": "./dist/esm/components/*/*.definition.js"
    }
  }
}
